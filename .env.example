# Copy to .env and fill values
# LLM provider
# - openai: any OpenAI-compatible Chat Completions API (default)
# - github_models: RETIRED (2026-07-30) - kept only to explain the failure
LLM_PROVIDER=openai

# Model provider key (required)
LLM_API_KEY=sk-...

# Model id (shared). Defaults to gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# Optional: an OpenAI-compatible endpoint other than OpenAI itself.
# Examples:
#   Azure AI Foundry : https://<resource>.services.ai.azure.com/models   (deployment-dependent)
#   Google Gemini    : https://generativelanguage.googleapis.com/v1beta/openai
#   Groq             : https://api.groq.com/openai/v1
# Leave empty to use https://api.openai.com/v1
LLM_BASE_URL=

MEDIUM_INTEGRATION_TOKEN=your_medium_integration_token
DEFAULT_AUTHOR_ID=
# publish_status: draft | public | unlisted
DEFAULT_PUBLISH_STATUS=draft
DEFAULT_TAGS=programming,dev,python
