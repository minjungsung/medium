# Copy to .env and fill values
# LLM provider
# - openai: uses OPENAI_API_KEY
# - github_models: uses GITHUB_TOKEN (or GH_MODELS_TOKEN) against a GitHub Models OpenAI-compatible endpoint
LLM_PROVIDER=github_models

# OpenAI
OPENAI_API_KEY=sk-...

# Model id (shared). On GitHub Models the id is publisher/model, e.g. openai/gpt-4o-mini
OPENAI_MODEL=openai/gpt-4o-mini

# GitHub Models
GITHUB_TOKEN=ghp_...
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

MEDIUM_INTEGRATION_TOKEN=your_medium_integration_token
DEFAULT_AUTHOR_ID=
# publish_status: draft | public | unlisted
DEFAULT_PUBLISH_STATUS=draft
DEFAULT_TAGS=programming,dev,python